---
AWSTemplateFormatVersion: 2010-09-09
Description: >
    https://github.com/aws-samples/aws-cloudformation-inline-python-lambda-example
    Amended Code for SG assignment - No DB set up required
Parameters:
  LambdaFunctionName:
    Type: String
    MinLength: '1'
    MaxLength: '64'
    AllowedPattern: '[a-zA-Z][a-zA-Z0-9_-]*'
    Description: The name of the Lambda function to be deployed
    Default: Lambda-DynamoDB-Function-CFNExample
  LambdaRoleName:
    Type: String
    MinLength: '1'
    MaxLength: '64'
    AllowedPattern: '[\w+=,.@-]+'
    Description: The name of the IAM role used as the Lambda execution role
    Default: Lambda-Role-CFNExample
  LambdaPolicyName:
    Type: String
    MinLength: '1'
    MaxLength: '128'
    AllowedPattern: '[\w+=,.@-]+'
    Default: Lambda-Policy-CFNExample
  NatureWatchTableName:
    Type: String
    Description: Existing DynamoDB table name
    
Resources:
  LambdaRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Ref LambdaRoleName
      Description: An execution role for a Lambda function launched by CloudFormation
      ManagedPolicyArns:
        - !Ref LambdaPolicy
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
        - Effect: Allow
          Principal:
            Service: lambda.amazonaws.com
          Action:
          - 'sts:AssumeRole'
      
  LambdaPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      ManagedPolicyName: !Ref LambdaPolicyName
      Description: Managed policy for a Lambda function launched by CloudFormation
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Action:
              - 'dynamodb:GetItem'
            Resource: !Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${NatureWatchTableName}'
          - Effect: Allow
            Action:
              - 'logs:CreateLogStream'
              - 'logs:PutLogEvents'
            Resource: !Join ['',['arn:', !Ref AWS::Partition, ':logs:', !Ref AWS::Region, ':', !Ref AWS::AccountId, ':log-group:/aws/lambda/', !Ref LambdaFunctionName, ':*']]
          - Effect: Allow
            Action:
              - 'logs:CreateLogGroup'
            Resource: !Sub 'arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:*'
        
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Join ['',['/aws/lambda/', !Ref LambdaFunctionName]]
      RetentionInDays: 30
            
  LambdaFunction:
    Type: AWS::Lambda::Function
    Properties:
      Description: Looks up user category and retrieves data
      FunctionName: !Ref LambdaFunctionName
      Handler: index.lambda_handler
      MemorySize: 128
      Runtime: python3.13 #updated to later version than original code
      Role: !GetAtt 'LambdaRole.Arn'
      Timeout: 240
      Environment:
        Variables:
          TableName: !Ref NatureWatchTableName #Updated for my specific table
      Code:
        ZipFile: |
            # Imports
            import os
            import boto3
    
            # Set up clients and resources
            ddbclient = boto3.client('dynamodb')
            
            # Env variables from CFN
            tablename = os.environ.get('TableName')

            def lambda_handler(event, context):
                # Lambda receives the requested category and retrieves the corresponding sightings count from DynamoDB.
                
                category = event.get('Category')
                if not category:
                    return {'message': 'Please re-enter'}

                response = ddbclient.get_item(
                    TableName=tablename,
                    Key={
                        'Category': {'S': category}
                    }                    
                )
                item = response.get('Item')
    
                if not item:
                    return {'message': 'Please re-enter'}

                return {
                   'Category': category,
                   'Sightings': int(item['Sightings']['N'])
                }
Outputs:
  CLI:
    Description: Use this command to invoke the Lambda function
    Value: !Sub |
      aws lambda invoke --function-name ${LambdaFunction} --payload '{"Category": "Birds"}' lambda-output.txt --cli-binary-format raw-in-base64-out
